{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Go Renovate configuration for Go modules, tools, and dependencies",
  "extends": ["github>arillso/.github:renovate-base#2026-08-21"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "Go version updates - manual review",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "groupName": "Go version",
      "semanticCommitType": "chore",
      "semanticCommitScope": "go",
      "minimumReleaseAge": "14 days",
      "automerge": false,
      "labels": ["go", "golang-version"],
      "prPriority": 20
    },
    {
      "description": "Group golang.org/x packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang.org/x/**"],
      "groupName": "golang.org/x packages",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Kubernetes packages - k8s.io/* and sigs.k8s.io/* are co-versioned, so separateMultipleMajor: false keeps their majors in one branch/PR to avoid mismatched-version build breaks.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "groupName": "Kubernetes packages",
      "semanticCommitType": "chore",
      "semanticCommitScope": "platform",
      "minimumReleaseAge": "7 days",
      "labels": ["platform"],
      "separateMultipleMajor": false
    },
    {
      "description": "Go platform packages - gRPC, Prometheus, google.golang.org. Independent ecosystems, so majors stay separate (no separateMultipleMajor override).",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "google.golang.org/**",
        "github.com/grpc-ecosystem/**",
        "github.com/prometheus/**"
      ],
      "groupName": "Go platform packages",
      "semanticCommitType": "chore",
      "semanticCommitScope": "platform",
      "minimumReleaseAge": "7 days",
      "labels": ["platform"]
    },
    {
      "description": "Group go.uber.org packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["go.uber.org/**"],
      "groupName": "go.uber.org packages",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group testing packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/testify/", "/gomock/", "/mockery/", "/ginkgo/", "/gomega/"],
      "groupName": "Go testing packages",
      "semanticCommitType": "chore",
      "semanticCommitScope": "test",
      "automerge": true
    },
    {
      "description": "Group linting and formatting tools",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/golangci-lint/", "/gofumpt/", "/goimports/", "/staticcheck/"],
      "groupName": "Go linting tools",
      "semanticCommitType": "chore",
      "semanticCommitScope": "lint",
      "automerge": true
    },
    {
      "description": "Development tools",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/air/", "/wire/", "/mockgen/", "/protoc-gen/", "/buf/", "/goreleaser/"],
      "groupName": "Go development tools",
      "semanticCommitType": "chore",
      "semanticCommitScope": "tools",
      "automerge": true,
      "labels": ["dev-tools"]
    },
    {
      "description": "Indirect dependencies - lower priority",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "groupName": "Go indirect dependencies",
      "prPriority": -5,
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Major Go module updates - manual review",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["!golang.org/x/**"],
      "automerge": false,
      "minimumReleaseAge": "14 days",
      "labels": ["go", "major-update"]
    },
    {
      "description": "Major golang.org/x updates - auto-approve (pseudo-versioned)",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang.org/x/**"],
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "minimumReleaseAge": "5 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Go version in .go-version files",
      "managerFilePatterns": ["/(^|/)\\.go-version$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)$"],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Go version in Makefiles",
      "managerFilePatterns": ["/^Makefile$/", "/\\.mk$/"],
      "matchStrings": ["GO_VERSION\\s*[:?]?=\\s*(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)"],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Go tools in Makefiles",
      "managerFilePatterns": ["/^Makefile$/", "/\\.mk$/"],
      "matchStrings": ["GOLANGCI_LINT_VERSION\\s*[:?]?=\\s*v?(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "golangci/golangci-lint",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Go tools versions in comments",
      "managerFilePatterns": ["/\\.ya?ml$/", "/Dockerfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*go-tool\\s+(?<depName>[^\\s]+)\\s+(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
