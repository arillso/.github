{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Ansible Renovate configuration for Galaxy collections, roles, and Python dependencies",
  "extends": ["github>arillso/.github:renovate-base#2026-08-14"],
  "packageRules": [
    {
      "description": "Group Ansible Galaxy collections",
      "matchManagers": ["ansible-galaxy"],
      "groupName": "ansible-collections"
    },
    {
      "description": "Group Ansible Galaxy roles",
      "matchManagers": ["ansible-galaxy"],
      "matchDepTypes": ["role"],
      "groupName": "ansible-roles"
    },
    {
      "description": "Group Python dependencies (ansible-core)",
      "matchManagers": ["pip_requirements", "pip_setup"],
      "groupName": "python-dependencies"
    },
    {
      "description": "Update Ansible collections even with range constraints",
      "matchManagers": ["ansible-galaxy"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Molecule platform images are pinned by digest so the test base image is reproducible. These images (e.g. geerlingguy/docker-*-ansible) publish only a `latest` tag, so pinDigests turns a bare `:latest` into `:latest@sha256:...` and Renovate keeps the digest fresh on its own update cadence.",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchFileNames": [
        "**/extensions/molecule/**/molecule.yml",
        "**/roles/**/molecule/**/molecule.yml"
      ],
      "pinDigests": true
    }
  ],
  "ansible-galaxy": {
    "managerFilePatterns": ["/(^|/)requirements\\.ya?ml$/", "/(^|/)galaxy\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^roles/.*/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*(?:\\r?\\n|\\r).*?:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?\\s*(?:\\r?\\n|\\r|$)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.*)${{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "description": "Molecule platform images. molecule.yml uses a compose-like `image:` key but is not a compose schema (`platforms:`, no `services:`), so the native docker-compose manager extracts nothing. Parse the `image:` line directly so depName is the repo, currentValue is the bare tag, and an optional `@sha256:...` is the digest — the shape the docker datasource needs to refresh the digest. Covers both layouts: collection-wide `extensions/molecule/<scenario>/` and per-role `roles/<role>/molecule/<scenario>/`.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)extensions/molecule/[^/]+/molecule\\.yml$/",
        "/(^|/)roles/[^/]+/molecule/[^/]+/molecule\\.yml$/"
      ],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "image:\\s*[\"']?(?<depName>[^:\\s\"']+):(?<currentValue>[^@\\s\"']+?)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?\\s*(?:\\r?\\n|\\r|$)"
      ]
    },
    {
      "description": "Keep .python-version pinned to a current released Python",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.python-version$/"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)"],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "pep440"
    }
  ]
}
